local function setSpeed(value)
	value = math.clamp(math.floor(value + 0.5), MIN_SPEED, MAX_SPEED)
	flySpeed = value
	local alpha = (value - MIN_SPEED) / (MAX_SPEED - MIN_SPEED)
	SliderFill.Size = UDim2.new(alpha, 0, 1, 0)
	Knob.Position = UDim2.new(alpha, 0, 0.5, 0)
	SpeedBox.Text = tostring(value)
end
setSpeed(flySpeed)

local sliding = false
local function updateSlider(input)
	local alpha = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X, 0, 1)
	setSpeed(MIN_SPEED + alpha * (MAX_SPEED - MIN_SPEED))
end

SliderHit.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		sliding = true
		updateSlider(input)
	end
end)

SpeedBox.FocusLost:Connect(function()
	setSpeed(tonumber(SpeedBox.Text) or flySpeed)
end)

local dragging, dragStart, startPos = false, nil, nil

TitleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = Main.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end
	if sliding then
		updateSlider(input)
	elseif dragging then
		local delta = input.Position - dragStart
		Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		sliding = false
		dragging = false
	end
end)

local controlsModule = nil
local warnedFallback = false

local function getMoveVector()
	if not controlsModule then
		pcall(function()
			local scripts = player:FindFirstChild("PlayerScripts")
			local module = scripts and scripts:FindFirstChild("PlayerModule")
			if module then
				controlsModule = require(module):GetControls()
			end
		end)
	end
	if controlsModule then
		local ok, v = pcall(function()
			return controlsModule:GetMoveVector()
		end)
		if ok and v then return v end
	end

	if not warnedFallback then
		warnedFallback = true
		warn("[Fly] PlayerModule controls unavailable, using WASD fallback")
	end
	local x = (UserInputService:IsKeyDown(Enum.KeyCode.D) and 1 or 0) - (UserInputService:IsKeyDown(Enum.KeyCode.A) and 1 or 0)
	local z = (UserInputService:IsKeyDown(Enum.KeyCode.S) and 1 or 0) - (UserInputService:IsKeyDown(Enum.KeyCode.W) and 1 or 0)
	return Vector3.new(x, 0, z)
end

local function updateFlyButton()
	if isFlying then
		FlyButton.Text = "FLY: ON  [F]"
		FlyButton.BackgroundColor3 = Color3.fromRGB(40, 200, 40)
	else
		FlyButton.Text = "FLY: OFF  [F]"
		FlyButton.BackgroundColor3 = Color3.fromRGB(46, 46, 53)
	end
end

local function cleanupFly()
	isFlying = false
	updateFlyButton()

	if flyConnection then flyConnection:Disconnect() flyConnection = nil end
	if bodyVel then bodyVel:Destroy() bodyVel = nil end
	if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
	if idleTrack then idleTrack:Stop() end
	if moveTrack then moveTrack:Stop() end
	if windSound then windSound:Stop() windSound:Destroy() windSound = nil end

	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then hum.PlatformStand = false end
end

local function toggleFly()
	if isFlying then
		cleanupFly()
		return
	end

	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then return end

	local animator = hum:FindFirstChildOfClass("Animator") or hum

	isFlying = true
	updateFlyButton()

	print("[Fly] enabled, speed =", flySpeed)

	local rigName = (hum.RigType == Enum.HumanoidRigType.R6) and "R6" or "R15"
	local animSet = ANIMS[rigName]
	print("[Fly] rig type =", rigName)

	local idleAnim = Instance.new("Animation")
	idleAnim.AnimationId = animSet.idle
	local moveAnim = Instance.new("Animation")
	moveAnim.AnimationId = animSet.move
	idleTrack = animator:LoadAnimation(idleAnim)
	moveTrack = animator:LoadAnimation(moveAnim)

	bodyVel = Instance.new("BodyVelocity")
	bodyVel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
	bodyVel.Velocity = Vector3.zero
	bodyVel.Parent = hrp

	bodyGyro = Instance.new("BodyGyro")
	bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
	bodyGyro.P = 10000
	bodyGyro.CFrame = camera.CFrame
	bodyGyro.Parent = hrp

	hum.PlatformStand = true
	idleTrack:Play()

	windSound = Instance.new("Sound")
	windSound.SoundId = WIND_SFX
	windSound.Looped = true
	windSound.Volume = 1.2
	windSound.Parent = hrp

	flyConnection = RunService.RenderStepped:Connect(function()
		if hum.Health <= 0 or not hrp.Parent then
			cleanupFly()
			return
		end

		local moveVector = getMoveVector()

		if moveVector.Magnitude > 0.01 then
			if not moveTrack.IsPlaying then
				idleTrack:Stop()
				moveTrack:Play()
			end
			if windSound and not windSound.Playing then windSound:Play() end

			local cf = camera.CFrame
			local flyDir = (cf.RightVector * moveVector.X) + (cf.LookVector * -moveVector.Z)
			bodyVel.Velocity = flyDir * flySpeed
			bodyGyro.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + flyDir)
		else
			if not idleTrack.IsPlaying then
				moveTrack:Stop()
				idleTrack:Play()
			end
			if windSound and windSound.Playing then windSound:Stop() end

			bodyVel.Velocity = Vector3.zero
			bodyGyro.CFrame = camera.CFrame
		end
	end)
end

local function updateNoclipButton()
	if noclipOn then
		NoclipButton.Text = "Noclip: ON [Y]"
		NoclipButton.BackgroundColor3 = Color3.fromRGB(40, 200, 40)
	else
		NoclipButton.Text = "Noclip: OFF [Y]"
		NoclipButton.BackgroundColor3 = Color3.fromRGB(46, 46, 53)
	end
end

local function restoreCollisions()
	for part, wasCollidable in pairs(originalCollide) do
		if part and part.Parent then
			part.CanCollide = wasCollidable
		end
	end
	table.clear(originalCollide)
end

local function toggleNoclip()
	noclipOn = not noclipOn
	updateNoclipButton()

	if noclipOn then
		noclipConnection = RunService.Stepped:Connect(function()
			local char = player.Character
			if not char then return end
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") then
					if originalCollide[part] == nil then
						originalCollide[part] = part.CanCollide
					end
					part.CanCollide = false
				end
			end
		end)
	else
		if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end
		restoreCollisions()
	end
end

player.CharacterAdded:Connect(function()
	table.clear(originalCollide)
end)

FlyButton.MouseButton1Click:Connect(toggleFly)
NoclipButton.MouseButton1Click:Connect(toggleNoclip)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == FLY_KEY then
		toggleFly()
	elseif input.KeyCode == NOCLIP_KEY then
		toggleNoclip()
	end
end)
